{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightos.local/schemas/fact-authority-binding.schema.json",
  "title": "Twin Fact Authority Binding Audit Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_field",
    "authority_mode",
    "source_ref",
    "conflict_behavior",
    "status"
  ],
  "properties": {
    "canonical_field": {
      "type": "string"
    },
    "authority_mode": {
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
    "conflict_behavior": {
      "type": "string"
    },
    "freshness_requirement": {
      "type": "string"
    },
    "network_disclosure_policy": {
      "type": "string"
    },
    "status": {
      "const": "AUDIT_CANDIDATE"
    }
  }
}
