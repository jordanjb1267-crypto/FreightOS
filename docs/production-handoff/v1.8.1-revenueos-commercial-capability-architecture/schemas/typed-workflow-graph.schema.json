{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightos.local/schemas/typed-workflow-graph.schema.json",
  "title": "FreightOS Typed Workflow Graph Audit Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "version",
    "status",
    "name",
    "plane",
    "workunit_type",
    "trigger",
    "single_accountable_owner",
    "nodes",
    "edges",
    "terminal_states",
    "invariants",
    "audit_rule"
  ],
  "properties": {
    "graph_id": {
      "type": "string",
      "pattern": "^(REV|FMI|XPL|TWIN)-G[0-9]{2}$"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "const": "AUDIT_CANDIDATE"
    },
    "name": {
      "type": "string"
    },
    "plane": {
      "type": "string"
    },
    "workunit_type": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "single_accountable_owner": {
      "const": true
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "state",
          "entry_preconditions",
          "exit_postconditions",
          "side_effect_class",
          "timeout",
          "retry_policy",
          "failure_transition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "entry_preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_postconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "side_effect_class": {
            "type": "string"
          },
          "timeout": {
            "type": "string"
          },
          "retry_policy": {
            "type": "string"
          },
          "failure_transition": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "artifact",
          "guard",
          "authority_check",
          "stale_invalidation"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "guard": {
            "type": "string"
          },
          "authority_check": {
            "type": "string"
          },
          "stale_invalidation": {
            "type": "string"
          }
        }
      }
    },
    "terminal_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_rule": {
      "type": "string"
    }
  }
}
