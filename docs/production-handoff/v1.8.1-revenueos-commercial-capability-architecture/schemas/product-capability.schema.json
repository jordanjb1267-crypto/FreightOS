{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "freightos://schemas/revenueos/product-capability.schema.json",
  "title": "ProductCapability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "version",
    "name",
    "participant_types",
    "status",
    "outcomes",
    "exclusions",
    "dependencies",
    "workflow_refs",
    "job_refs",
    "command_classes",
    "activation_gates",
    "meters"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "participant_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEWED",
        "PILOT_ELIGIBLE",
        "SELLABLE_BOUNDED",
        "SELLABLE_GENERAL",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "job_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "command_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_integrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_autonomy_claim": {
      "type": "string"
    },
    "required_certification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activation_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "meters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    }
  }
}
