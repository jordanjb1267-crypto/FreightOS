{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FreightOS Market Signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "version",
    "signal_class",
    "metric_type",
    "mode",
    "scope",
    "effective_at",
    "freshness",
    "sources",
    "confidence",
    "rights_policy",
    "created_at"
  ],
  "properties": {
    "signal_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "signal_class": {
      "enum": [
        "observation",
        "normalized_observation",
        "derived_indicator",
        "forecast",
        "regime_classification",
        "news_event",
        "disruption_signal",
        "customer_impact_assessment",
        "recommendation_input"
      ]
    },
    "metric_type": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "geography"
      ],
      "properties": {
        "geography": {
          "type": "string"
        },
        "lane": {
          "type": [
            "string",
            "null"
          ]
        },
        "equipment": {
          "type": [
            "string",
            "null"
          ]
        },
        "commodity": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "freshness": {
      "enum": [
        "CURRENT",
        "AGING",
        "STALE",
        "UNKNOWN",
        "WITHHELD"
      ]
    },
    "value": {},
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_ref"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "method_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights_policy": {
      "type": "string",
      "minLength": 1
    },
    "disclosure_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "correction_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
