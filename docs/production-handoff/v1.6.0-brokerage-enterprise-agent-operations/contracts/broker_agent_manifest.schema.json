{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "freightos://schemas/broker-agent-manifest/v1",
  "title": "BrokerAgentManifest",
  "type": "object",
  "required": [
    "agentId",
    "tenantId",
    "brokerageEntityId",
    "role",
    "manifestVersion",
    "scope",
    "tools",
    "commands",
    "policyVersion",
    "autonomy",
    "killSwitch"
