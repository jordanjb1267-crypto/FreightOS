      "type": "string"
    },
    "workflowId": {
      "type": "string"
    },
    "actionClass": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "level": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5"
      ]
    },
    "limits": {
      "type": "object"
    },
    "policyVersion": {
      "type": "string"
    },
    "evidenceRef": {
      "type": "string"
    },
    "approvedBy": {
      "type": "string"
    },
    "effectiveAt": {
      "type": "string"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "revokedAt": {
      "type": [
        "string",
        "null"
      ]
