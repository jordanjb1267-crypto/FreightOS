{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freightos.internal/schemas/reconciliation-record.v1.json",
  "title": "FreightOS Reconciliation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["reconciliation_id", "workflow_type", "resource_id", "expected_state", "observed_state", "severity", "status", "detected_at"],
  "properties": {
    "reconciliation_id": {"type": "string"},
    "workflow_type": {"type": "string"},
    "resource_id": {"type": "string"},
    "organization_id": {"type": "string"},
    "connector_id": {"type": "string"},
    "expected_state": {},
    "observed_state": {},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "severity": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "status": {"enum": ["open", "investigating", "contained", "resolved", "accepted_exception"]},
    "owner": {"type": "string"},
    "detected_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "resolution_code": {"type": "string"},
    "correlation_id": {"type": "string"}
  }
}
