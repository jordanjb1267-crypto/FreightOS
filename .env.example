# RIG FreightOS — example environment.
#
# Copy to `.env` for local development. `.env` is gitignored and must never be committed.
# Constitution Art. III.4: production customer data cannot be copied to local development.
# 02_GOVERNANCE: credentials are never stored in prompts, code, fixtures, logs, or memory.
#
# Phase 0 selects NO production credential, AI provider, or cloud provider. Every value below is
# a local development default. Validated at startup by packages/config — unknown or missing
# required values fail closed rather than defaulting silently.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# Deployment environment. One of: development | test | staging | production
# Anything other than `development` requires explicitly supplied values for every secret.
FREIGHTOS_ENV=development

# ---------------------------------------------------------------------------
# Database — PostgreSQL 16 baseline (ADR-0016)
# ---------------------------------------------------------------------------
# Owner of the schema. Runs migrations. NOT used by the application at runtime.
#
# The role must be provisioned once per cluster before the first migration, by a superuser:
#   psql -v ON_ERROR_STOP=1 -U postgres -d postgres \
#        -v migrator_password="'<from your secret manager>'" -v db_name=freightos \
#        -f scripts/bootstrap-migration-authority.sql
#
# It holds LOGIN and CREATEROLE and owns the database, and it holds neither SUPERUSER nor
# BYPASSRLS. Never point this at a superuser: a superuser bypasses row-level security, so a
# migration that cannot write through its own policies would appear to succeed.
DATABASE_MIGRATOR_URL=postgresql://freightos_migrator:devonly@localhost:5432/freightos

# Application role. Subject to row-level security. This is the runtime connection.
DATABASE_APP_URL=postgresql://freightos_app:devonly@localhost:5432/freightos

# Control-plane role. Explicit, audited RLS bypass for global control-plane operations only
# (04_ENTERPRISE_SCALE_AND_TENANCY: tenant routing, catalogs, registries). Never the default.
DATABASE_CONTROL_PLANE_URL=postgresql://freightos_control_plane:devonly@localhost:5432/freightos

DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Observability (OpenTelemetry)
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=freightos
# Empty means "no exporter configured" — telemetry is collected in-process and dropped.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Object storage — S3-compatible abstraction, local MinIO (ADR-0016)
# ---------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=freightos-local
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1

# ---------------------------------------------------------------------------
# Durable workflows — Temporal (ADR-0016). Not used in Phase 0.
# ---------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=freightos-dev

# ---------------------------------------------------------------------------
# Model gateway — provider-independent (ADR-0016).
# Phase 0 selects no provider. Empty means the gateway is disabled and any model call fails
# closed rather than reaching an unconfigured provider.
# ---------------------------------------------------------------------------
MODEL_GATEWAY_ENABLED=false

# ---------------------------------------------------------------------------
# Deferred-module flags — 21_SEQUENCING_DOCTRINE mandatory defaults.
# All eight MUST be false. scripts/validate-scope.mjs fails the build otherwise.
# No feature flag alone may activate brokerage or live autonomous-vehicle operations.
# ---------------------------------------------------------------------------
FACILITYOS_STANDALONE_ENABLED=false
AUTONOMOUS_DISPATCH_A4_ENABLED=false
BROKERAGE_EXECUTION_ENABLED=false
FREIGHT_EXCHANGE_ENABLED=false
AUTONOMOUS_VEHICLE_LIVE_MISSIONS_ENABLED=false
RAIL_OPERATIONS_ENABLED=false
OCEAN_OPERATIONS_ENABLED=false
AIR_OPERATIONS_ENABLED=false
