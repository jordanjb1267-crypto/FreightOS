{
  "name": "freightos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RIG FreightOS — governed freight operating system. Horizon 1 build scope.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:config-contract": "vitest run --project config-contract",
    "test:coverage": "vitest run --project unit --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.all=false --coverage.include='packages/identity/src/**' --coverage.include='packages/context/src/capabilities.ts' --coverage.thresholds.lines=90 --coverage.thresholds.branches=85 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "db:up": "node --experimental-strip-types packages/database/src/cli.ts up",
    "db:down": "node --experimental-strip-types packages/database/src/cli.ts down",
    "db:status": "node --experimental-strip-types packages/database/src/cli.ts status",
    "sync:handoff": "node scripts/sync-handoff.mjs",
    "validate:handoff": "python3 docs/production-handoff/v1.2/scripts/validate_handoff.py",
    "validate:provenance": "node scripts/check-handoff-provenance.mjs",
    "validate:scope": "node scripts/validate-scope.mjs",
    "validate:network": "node scripts/check-network-governance.mjs",
    "validate:architecture": "node scripts/check-architecture-governance.mjs",
    "validate:ccep": "node scripts/check-ccep-governance.mjs",
    "validate": "pnpm validate:handoff && pnpm validate:provenance && pnpm validate:network && pnpm validate:architecture && pnpm validate:ccep && pnpm validate:egress && pnpm validate:egress-allowlist && pnpm validate:scope",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm validate",
    "validate:egress": "node scripts/check-network-egress.mjs",
    "validate:egress-allowlist": "node scripts/check-egress-allowlist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.13.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3"
    }
  }
}
